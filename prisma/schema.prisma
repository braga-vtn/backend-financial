generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int                @id @default(autoincrement())
  clerkId          String             @unique @default(cuid())
  email            String             @unique
  password         String
  updatedAt        DateTime           @default(now()) @updatedAt
  createdAt        DateTime           @default(now())
  Token            Token[]
  Professional     Professional[]
  Category         Category[]
  Cycle            Cycle[]
  Expense          Expense[]
  RecurringExpense RecurringExpense[]
}

enum TokenType {
  refresh
  register
}

model Token {
  id        Int       @id @default(autoincrement())
  type      TokenType
  token     String    @unique
  payload   Json?
  expires   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  User      User      @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
}

model Professional {
  id        String    @id @default(cuid())
  name      String
  role      String?
  phone     String?
  pixKey    String?
  active    Boolean   @default(true)
  leftAt    DateTime? @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  User      User      @relation(fields: [userId], references: [clerkId], onDelete: Cascade)

  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  cycleParticipants CycleParticipant[]
  settlementsFrom   Settlement[]       @relation("SettlementFrom")
  settlementsTo     Settlement[]       @relation("SettlementTo")

  @@index([active])
  @@map("professionals")
}

// ───────────── Financeiro ─────────────
// Dinheiro sempre em centavos (Int). Datas de negócio em @db.Date.

enum CostType {
  FIXED
  VARIABLE
}

enum CycleStatus {
  OPEN
  CLOSED
}

model Category {
  id        String   @id @default(cuid())
  name      String
  type      CostType
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  User      User     @relation(fields: [userId], references: [clerkId], onDelete: Cascade)

  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  @@unique([userId, name])
  @@map("categories")
}

// Período de 15 a 14. Criado sob demanda (get-or-create).
model Cycle {
  id        String      @id @default(cuid())
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date
  status    CycleStatus @default(OPEN)
  closedAt  DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  userId    String
  User      User        @relation(fields: [userId], references: [clerkId], onDelete: Cascade)

  expenses     Expense[]
  participants CycleParticipant[]
  settlements  Settlement[]

  @@unique([userId, startDate])
  @@index([userId, status])
  @@map("cycles")
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amountCents Int
  date        DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  User        User     @relation(fields: [userId], references: [clerkId], onDelete: Cascade)

  cycleId String
  cycle   Cycle  @relation(fields: [cycleId], references: [id], onDelete: Restrict)

  paidById String
  paidBy   Professional @relation(fields: [paidById], references: [id], onDelete: Restrict)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // preenchido quando o lançamento nasce de um custo fixo
  recurringId String?
  recurring   RecurringExpense? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  // impede gerar o mesmo custo fixo duas vezes no mesmo ciclo
  @@unique([recurringId, cycleId])
  @@index([userId, cycleId])
  @@index([paidById])
  @@index([categoryId])
  @@map("expenses")
}

model RecurringExpense {
  id          String   @id @default(cuid())
  description String
  amountCents Int
  dayOfMonth  Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  User        User     @relation(fields: [userId], references: [clerkId], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  defaultPaidById String?
  defaultPaidBy   Professional? @relation(fields: [defaultPaidById], references: [id], onDelete: SetNull)

  expenses Expense[]

  @@index([userId, active])
  @@map("recurring_expenses")
}

// Foto congelada do fechamento: quanto cada um pagou, a parte e o saldo.
model CycleParticipant {
  id             String @id @default(cuid())
  paidCents      Int
  shareCents     Int
  balanceCents   Int // paidCents - shareCents (positivo = recebe)
  cycleId        String
  cycle          Cycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)

  @@unique([cycleId, professionalId])
  @@map("cycle_participants")
}

// Transferências sugeridas no fechamento ("Kelly paga 750 à Luara").
model Settlement {
  id          String    @id @default(cuid())
  amountCents Int
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  cycleId     String
  cycle       Cycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  fromId String
  from   Professional @relation("SettlementFrom", fields: [fromId], references: [id], onDelete: Restrict)

  toId String
  to   Professional @relation("SettlementTo", fields: [toId], references: [id], onDelete: Restrict)

  @@index([cycleId])
  @@map("settlements")
}
